# Generate a key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Same value in ESP32 LINE_API_KEY and dashboard API key field.
DATALOGGER_API_KEY=
# LINE Messaging API token (NOT a retired LINE Notify token).
LINE_CHANNEL_ACCESS_TOKEN=
# User U..., group C..., or room R... ID. LINE_GROUP_ID remains a fallback.
LINE_TARGET_ID=
# Required only for POST /api/line/webhook to discover recipient IDs.
LINE_CHANNEL_SECRET=
# Relative paths resolve from this app directory; use persistent storage in production.
DATABASE_PATH=data/datalogger.sqlite3
# Shorter than the ESP32 HTTP timeout (default 10 seconds).
LINE_HTTP_TIMEOUT_SECONDS=6
